{"type": "excalidraw", "version": 2, "source": "youtube-diagrams", "elements": [{"type": "text", "id": "bc228ad0-b0a", "x": 80, "y": 80, "width": 1510, "height": 72.0, "text": "How RAG Works", "fontSize": 48, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e1e1e", "opacity": 100, "angle": 0, "version": 4, "versionNonce": 0, "isDeleted": false, "groupIds": [], "boundElements": null}, {"type": "text", "id": "5a01091f-504", "x": 80, "y": 140, "width": 1510, "height": 30.0, "text": "6 key concepts explained", "fontSize": 20, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#888888", "opacity": 100, "angle": 0, "version": 4, "versionNonce": 0, "isDeleted": false, "groupIds": [], "boundElements": null}, {"type": "rectangle", "id": "9054c490-5ff", "x": 80, "y": 200, "width": 450, "height": 500, "backgroundColor": "#ffffff", "strokeColor": "#1e1e1e", "strokeWidth": 1, "fillStyle": "solid", "roughness": 1, "opacity": 100, "angle": 0, "version": 4, "versionNonce": 0, "isDeleted": false, "groupIds": [], "boundElements": null, "roundness": {"type": 3}}, {"type": "rectangle", "id": "776eef24-a15", "x": 80, "y": 200, "width": 450, "height": 8, "backgroundColor": "#a5d8ff", "strokeColor": "transparent", "strokeWidth": 0, "fillStyle": "solid", "roughness": 1, "opacity": 100, "angle": 0, "version": 4, "versionNonce": 0, "isDeleted": false, "groupIds": [], "boundElements": null, "roundness": {"type": 0}}, {"type": "rectangle", "id": "e44eec81-98c", "x": 95, "y": 220, "width": 36, "height": 36, "backgroundColor": "#a5d8ff", "strokeColor": "transparent", "strokeWidth": 2, "fillStyle": "solid", "roughness": 1, "opacity": 100, "angle": 0, "version": 4, "versionNonce": 0, "isDeleted": false, "groupIds": [], "boundElements": null, "roundness": {"type": 3}}, {"type": "text", "id": "c4ab7132-ead", "x": 102, "y": 224, "width": 24, "height": 33.0, "text": "1", "fontSize": 22, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e1e1e", "opacity": 100, "angle": 0, "version": 4, "versionNonce": 0, "isDeleted": false, "groupIds": [], "boundElements": null}, {"type": "text", "id": "680a541b-521", "x": 140, "y": 222, "width": 370, "height": 42.0, "text": "What is RAG?", "fontSize": 28, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e1e1e", "opacity": 100, "angle": 0, "version": 4, "versionNonce": 0, "isDeleted": false, "groupIds": [], "boundElements": null}, {"type": "text", "id": "8f981fec-7a2", "x": 95, "y": 265, "width": 420, "height": 120.0, "text": "RAG stands for Retrieval-Augmented Generation. It's a technique that grounds LLM responses in real data by retrieving relevant documents before generating a response.", "fontSize": 16, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#555555", "opacity": 100, "angle": 0, "version": 4, "versionNonce": 0, "isDeleted": false, "groupIds": [], "boundElements": null}, {"type": "image", "id": "88c1e5e2-54b", "x": 95, "y": 405, "width": 420, "height": 280, "fileId": "5f454db6-ce5", "status": "saved", "scale": [1, 1], "version": 4, "versionNonce": 0, "isDeleted": false, "groupIds": [], "boundElements": null, "opacity": 100, "angle": 0, "strokeColor": "transparent", "backgroundColor": "transparent"}, {"type": "rectangle", "id": "88c9ac31-bf3", "x": 610, "y": 200, "width": 450, "height": 500, "backgroundColor": "#ffffff", "strokeColor": "#1e1e1e", "strokeWidth": 1, "fillStyle": "solid", "roughness": 1, "opacity": 100, "angle": 0, "version": 4, "versionNonce": 0, "isDeleted": false, "groupIds": [], "boundElements": null, "roundness": {"type": 3}}, {"type": "rectangle", "id": "a7155a0d-24e", "x": 610, "y": 200, "width": 450, "height": 8, "backgroundColor": "#ffd8a8", "strokeColor": "transparent", "strokeWidth": 0, "fillStyle": "solid", "roughness": 1, "opacity": 100, "angle": 0, "version": 4, "versionNonce": 0, "isDeleted": false, "groupIds": [], "boundElements": null, "roundness": {"type": 0}}, {"type": "rectangle", "id": "f5e72179-833", "x": 625, "y": 220, "width": 36, "height": 36, "backgroundColor": "#ffd8a8", "strokeColor": "transparent", "strokeWidth": 2, "fillStyle": "solid", "roughness": 1, "opacity": 100, "angle": 0, "version": 4, "versionNonce": 0, "isDeleted": false, "groupIds": [], "boundElements": null, "roundness": {"type": 3}}, {"type": "text", "id": "33d957c5-fa6", "x": 632, "y": 224, "width": 24, "height": 33.0, "text": "2", "fontSize": 22, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e1e1e", "opacity": 100, "angle": 0, "version": 4, "versionNonce": 0, "isDeleted": false, "groupIds": [], "boundElements": null}, {"type": "text", "id": "19431c8d-29b", "x": 670, "y": 222, "width": 370, "height": 42.0, "text": "The User Query", "fontSize": 28, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e1e1e", "opacity": 100, "angle": 0, "version": 4, "versionNonce": 0, "isDeleted": false, "groupIds": [], "boundElements": null}, {"type": "text", "id": "1349897b-c9c", "x": 625, "y": 265, "width": 420, "height": 72.0, "text": "The user asks a question in natural language. This query gets converted into an embedding vector for similarity search.", "fontSize": 16, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#555555", "opacity": 100, "angle": 0, "version": 4, "versionNonce": 0, "isDeleted": false, "groupIds": [], "boundElements": null}, {"type": "image", "id": "dfb71b75-bd8", "x": 625, "y": 405, "width": 420, "height": 280, "fileId": "02018eb9-0a9", "status": "saved", "scale": [1, 1], "version": 4, "versionNonce": 0, "isDeleted": false, "groupIds": [], "boundElements": null, "opacity": 100, "angle": 0, "strokeColor": "transparent", "backgroundColor": "transparent"}, {"type": "rectangle", "id": "4678bb28-940", "x": 1140, "y": 200, "width": 450, "height": 500, "backgroundColor": "#ffffff", "strokeColor": "#1e1e1e", "strokeWidth": 1, "fillStyle": "solid", "roughness": 1, "opacity": 100, "angle": 0, "version": 4, "versionNonce": 0, "isDeleted": false, "groupIds": [], "boundElements": null, "roundness": {"type": 3}}, {"type": "rectangle", "id": "4acdca12-705", "x": 1140, "y": 200, "width": 450, "height": 8, "backgroundColor": "#b2f2bb", "strokeColor": "transparent", "strokeWidth": 0, "fillStyle": "solid", "roughness": 1, "opacity": 100, "angle": 0, "version": 4, "versionNonce": 0, "isDeleted": false, "groupIds": [], "boundElements": null, "roundness": {"type": 0}}, {"type": "rectangle", "id": "d411e06e-67d", "x": 1155, "y": 220, "width": 36, "height": 36, "backgroundColor": "#b2f2bb", "strokeColor": "transparent", "strokeWidth": 2, "fillStyle": "solid", "roughness": 1, "opacity": 100, "angle": 0, "version": 4, "versionNonce": 0, "isDeleted": false, "groupIds": [], "boundElements": null, "roundness": {"type": 3}}, {"type": "text", "id": "a1118821-293", "x": 1162, "y": 224, "width": 24, "height": 33.0, "text": "3", "fontSize": 22, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e1e1e", "opacity": 100, "angle": 0, "version": 4, "versionNonce": 0, "isDeleted": false, "groupIds": [], "boundElements": null}, {"type": "text", "id": "53e72b59-8a4", "x": 1200, "y": 222, "width": 370, "height": 42.0, "text": "Retrieval Step", "fontSize": 28, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e1e1e", "opacity": 100, "angle": 0, "version": 4, "versionNonce": 0, "isDeleted": false, "groupIds": [], "boundElements": null}, {"type": "text", "id": "fb5edd60-e69", "x": 1155, "y": 265, "width": 420, "height": 96.0, "text": "The system searches a vector database for documents that are semantically similar to the query. This typically uses cosine similarity or dot product matching.", "fontSize": 16, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#555555", "opacity": 100, "angle": 0, "version": 4, "versionNonce": 0, "isDeleted": false, "groupIds": [], "boundElements": null}, {"type": "image", "id": "1d0051c0-210", "x": 1155, "y": 405, "width": 420, "height": 280, "fileId": "d69ca490-00b", "status": "saved", "scale": [1, 1], "version": 4, "versionNonce": 0, "isDeleted": false, "groupIds": [], "boundElements": null, "opacity": 100, "angle": 0, "strokeColor": "transparent", "backgroundColor": "transparent"}, {"type": "rectangle", "id": "86a42d91-37d", "x": 80, "y": 800, "width": 450, "height": 500, "backgroundColor": "#ffffff", "strokeColor": "#1e1e1e", "strokeWidth": 1, "fillStyle": "solid", "roughness": 1, "opacity": 100, "angle": 0, "version": 4, "versionNonce": 0, "isDeleted": false, "groupIds": [], "boundElements": null, "roundness": {"type": 3}}, {"type": "rectangle", "id": "726a867f-d57", "x": 80, "y": 800, "width": 450, "height": 8, "backgroundColor": "#fcc2d7", "strokeColor": "transparent", "strokeWidth": 0, "fillStyle": "solid", "roughness": 1, "opacity": 100, "angle": 0, "version": 4, "versionNonce": 0, "isDeleted": false, "groupIds": [], "boundElements": null, "roundness": {"type": 0}}, {"type": "rectangle", "id": "9b8557c3-47e", "x": 95, "y": 820, "width": 36, "height": 36, "backgroundColor": "#fcc2d7", "strokeColor": "transparent", "strokeWidth": 2, "fillStyle": "solid", "roughness": 1, "opacity": 100, "angle": 0, "version": 4, "versionNonce": 0, "isDeleted": false, "groupIds": [], "boundElements": null, "roundness": {"type": 3}}, {"type": "text", "id": "ab9b42b9-563", "x": 102, "y": 824, "width": 24, "height": 33.0, "text": "4", "fontSize": 22, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e1e1e", "opacity": 100, "angle": 0, "version": 4, "versionNonce": 0, "isDeleted": false, "groupIds": [], "boundElements": null}, {"type": "text", "id": "cdc8fac7-601", "x": 140, "y": 822, "width": 370, "height": 42.0, "text": "Augmentation", "fontSize": 28, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e1e1e", "opacity": 100, "angle": 0, "version": 4, "versionNonce": 0, "isDeleted": false, "groupIds": [], "boundElements": null}, {"type": "text", "id": "112b037a-fd8", "x": 95, "y": 865, "width": 420, "height": 96.0, "text": "The retrieved documents are combined with the original query to create an enriched prompt. This gives the LLM factual context to work with.", "fontSize": 16, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#555555", "opacity": 100, "angle": 0, "version": 4, "versionNonce": 0, "isDeleted": false, "groupIds": [], "boundElements": null}, {"type": "image", "id": "142a719f-fd2", "x": 95, "y": 1005, "width": 420, "height": 280, "fileId": "db126ce8-41b", "status": "saved", "scale": [1, 1], "version": 4, "versionNonce": 0, "isDeleted": false, "groupIds": [], "boundElements": null, "opacity": 100, "angle": 0, "strokeColor": "transparent", "backgroundColor": "transparent"}, {"type": "rectangle", "id": "feb8a4c1-b90", "x": 610, "y": 800, "width": 450, "height": 500, "backgroundColor": "#ffffff", "strokeColor": "#1e1e1e", "strokeWidth": 1, "fillStyle": "solid", "roughness": 1, "opacity": 100, "angle": 0, "version": 4, "versionNonce": 0, "isDeleted": false, "groupIds": [], "boundElements": null, "roundness": {"type": 3}}, {"type": "rectangle", "id": "61eb7add-a0b", "x": 610, "y": 800, "width": 450, "height": 8, "backgroundColor": "#d0bfff", "strokeColor": "transparent", "strokeWidth": 0, "fillStyle": "solid", "roughness": 1, "opacity": 100, "angle": 0, "version": 4, "versionNonce": 0, "isDeleted": false, "groupIds": [], "boundElements": null, "roundness": {"type": 0}}, {"type": "rectangle", "id": "07c4f919-e5d", "x": 625, "y": 820, "width": 36, "height": 36, "backgroundColor": "#d0bfff", "strokeColor": "transparent", "strokeWidth": 2, "fillStyle": "solid", "roughness": 1, "opacity": 100, "angle": 0, "version": 4, "versionNonce": 0, "isDeleted": false, "groupIds": [], "boundElements": null, "roundness": {"type": 3}}, {"type": "text", "id": "1455b6e7-b79", "x": 632, "y": 824, "width": 24, "height": 33.0, "text": "5", "fontSize": 22, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e1e1e", "opacity": 100, "angle": 0, "version": 4, "versionNonce": 0, "isDeleted": false, "groupIds": [], "boundElements": null}, {"type": "text", "id": "56a3ddc8-502", "x": 670, "y": 822, "width": 370, "height": 42.0, "text": "Generation", "fontSize": 28, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e1e1e", "opacity": 100, "angle": 0, "version": 4, "versionNonce": 0, "isDeleted": false, "groupIds": [], "boundElements": null}, {"type": "text", "id": "564494fe-c08", "x": 625, "y": 865, "width": 420, "height": 96.0, "text": "The LLM processes the augmented prompt and generates a response that's grounded in the retrieved data. Citations can be traced back to source documents.", "fontSize": 16, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#555555", "opacity": 100, "angle": 0, "version": 4, "versionNonce": 0, "isDeleted": false, "groupIds": [], "boundElements": null}, {"type": "image", "id": "8cabde2d-dcf", "x": 625, "y": 1005, "width": 420, "height": 280, "fileId": "d5ad7777-a82", "status": "saved", "scale": [1, 1], "version": 4, "versionNonce": 0, "isDeleted": false, "groupIds": [], "boundElements": null, "opacity": 100, "angle": 0, "strokeColor": "transparent", "backgroundColor": "transparent"}, {"type": "rectangle", "id": "133a3723-7e5", "x": 1140, "y": 800, "width": 450, "height": 500, "backgroundColor": "#ffffff", "strokeColor": "#1e1e1e", "strokeWidth": 1, "fillStyle": "solid", "roughness": 1, "opacity": 100, "angle": 0, "version": 4, "versionNonce": 0, "isDeleted": false, "groupIds": [], "boundElements": null, "roundness": {"type": 3}}, {"type": "rectangle", "id": "832cf22f-b9b", "x": 1140, "y": 800, "width": 450, "height": 8, "backgroundColor": "#99e9f2", "strokeColor": "transparent", "strokeWidth": 0, "fillStyle": "solid", "roughness": 1, "opacity": 100, "angle": 0, "version": 4, "versionNonce": 0, "isDeleted": false, "groupIds": [], "boundElements": null, "roundness": {"type": 0}}, {"type": "rectangle", "id": "71afc822-070", "x": 1155, "y": 820, "width": 36, "height": 36, "backgroundColor": "#99e9f2", "strokeColor": "transparent", "strokeWidth": 2, "fillStyle": "solid", "roughness": 1, "opacity": 100, "angle": 0, "version": 4, "versionNonce": 0, "isDeleted": false, "groupIds": [], "boundElements": null, "roundness": {"type": 3}}, {"type": "text", "id": "7252d749-465", "x": 1162, "y": 824, "width": 24, "height": 33.0, "text": "6", "fontSize": 22, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e1e1e", "opacity": 100, "angle": 0, "version": 4, "versionNonce": 0, "isDeleted": false, "groupIds": [], "boundElements": null}, {"type": "text", "id": "d08d5fbd-445", "x": 1200, "y": 822, "width": 370, "height": 42.0, "text": "Why RAG Matters", "fontSize": 28, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#1e1e1e", "opacity": 100, "angle": 0, "version": 4, "versionNonce": 0, "isDeleted": false, "groupIds": [], "boundElements": null}, {"type": "text", "id": "367cfd9f-034", "x": 1155, "y": 865, "width": 420, "height": 96.0, "text": "RAG reduces hallucinations, keeps responses current without retraining, and provides source attribution for trust and verification.", "fontSize": 16, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "strokeColor": "#555555", "opacity": 100, "angle": 0, "version": 4, "versionNonce": 0, "isDeleted": false, "groupIds": [], "boundElements": null}, {"type": "image", "id": "20eeb32b-59f", "x": 1155, "y": 1005, "width": 420, "height": 280, "fileId": "dc3de3f9-221", "status": "saved", "scale": [1, 1], "version": 4, "versionNonce": 0, "isDeleted": false, "groupIds": [], "boundElements": null, "opacity": 100, "angle": 0, "strokeColor": "transparent", "backgroundColor": "transparent"}, {"type": "arrow", "id": "c59b9a94-fb7"